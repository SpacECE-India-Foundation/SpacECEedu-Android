<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_ternary"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/_24sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_no_child"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_32sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:fontFamily="@font/font_poppins_medium"
                android:gravity="center"
                android:paddingVertical="@dimen/_4sdp"
                android:text="Track your child's progress with creative milestone activities"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_add_child"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/bg_upload_button"
                android:fontFamily="@font/font_poppins_semibold"
                android:paddingHorizontal="@dimen/_32sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:text="Click here to add Child"
                android:textColor="@color/color_white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_child_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:fontFamily="@font/font_poppins_semibold"
                    android:text="Parent Dashboard"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View style="@style/StyleSectionUnderline" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/layout_child_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_8sdp">

                <!-- Horizontal RecyclerView (top row) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChildren"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="4"
                    tools:listitem="@layout/item_child" />

                <!-- Profile image with yellow circular border -->
                <RelativeLayout
                    android:id="@+id/profileContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rvChildren"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="8dp"
                    android:elevation="2dp">

                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_mask"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile_pic" />

                    <ImageView
                        android:id="@+id/imgBorder"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_alignStart="@id/imgProfile"
                        android:layout_alignTop="@id/imgProfile"
                        android:layout_alignEnd="@id/imgProfile"
                        android:layout_alignBottom="@id/imgProfile"
                        android:src="@drawable/bg_photo_circle" />
                </RelativeLayout>

                <!-- Main card content block -->
                <LinearLayout
                    android:id="@+id/detailsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/profileContainer"
                    android:layout_marginHorizontal="@dimen/_4sdp"
                    android:layout_marginTop="-30dp"
                    android:background="@drawable/bg_rectangle_1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- name / age / location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/font_poppins_semibold"
                            android:letterSpacing="0.02"
                            android:text="Karan Kumar"
                            android:textColor="#000000"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/font_poppins"
                            android:text="2 Years"
                            android:textColor="#FF6F00"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/font_poppins"
                            android:text="SpacECE Center - Dwarka"
                            android:textColor="#333333"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- spacer -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <View
                        style="@style/StyleSectionUnderline"
                        android:layout_width="90dp"
                        android:layout_height="3dp" />

                    <TextView
                        android:id="@+id/tvPhysicalTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font_poppins_medium"
                        android:text="Physical Stats"
                        android:textColor="#000000"
                        android:textSize="11sp" />

                    <!-- Height & Weight -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="30dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:fontFamily="@font/font_poppins"
                                android:text="Height : "
                                android:textColor="#333333"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvHeightValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_poppins"
                                android:text="110 cm"
                                android:textColor="#333333"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:fontFamily="@font/font_poppins"
                                android:text="Weight : "
                                android:textColor="#333333"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvWeightValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_poppins"
                                android:text="19 kg"
                                android:textColor="#333333"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- next section -->
                    <View
                        style="@style/StyleSectionUnderline"
                        android:layout_width="90dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tvLatestTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/font_poppins_medium"
                        android:text="Latest Update"
                        android:textColor="#000000"
                        android:textSize="11sp" />

                    <!-- Last / Next Check -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="30dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:fontFamily="@font/font_poppins"
                                android:text="Last Check : "
                                android:textColor="#333333"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvLastCheck"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_poppins"
                                android:text="110 cm"
                                android:textColor="#333333"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:fontFamily="@font/font_poppins"
                                android:text="Next Check: "
                                android:textColor="#333333"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvNextCheck"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_poppins"
                                android:text="Today"
                                android:textColor="#333333"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNotice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font_poppins"
                        android:text="Today is your child’s physical data update"
                        android:textColor="#FF0002"
                        android:textSize="11sp" />

                    <!-- Inputs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/font_poppins"
                            android:text="Height : "
                            android:textColor="#757575"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/heightInput"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:hint="cm"
                            android:inputType="number" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="@font/font_poppins"
                            android:text="Weight : "
                            android:textColor="#757575"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/weightInput"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input"
                            android:gravity="center"
                            android:hint="kg"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnSubmit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_book_button"
                        android:fontFamily="@font/font_poppins_medium"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="5dp"
                        android:text="Submit"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                </LinearLayout>

            </RelativeLayout>


            <LinearLayout
                android:id="@+id/ll_milestoneTracker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginVertical="@dimen/_8sdp"
                android:background="@drawable/bg_linear_gradient_miestone_tracker"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Left Section: Texts -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMilestoneTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/font_poppins_semibold"
                        android:letterSpacing="-0.016"
                        android:text="Milestone Tracker"
                        android:textColor="#FFFFFF"
                        android:textFontWeight="600"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvMilestoneSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/font_poppins"
                        android:text="We assign daily tasks for your children's development"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Right Section: Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Small label on top -->
                    <TextView
                        android:id="@+id/tvTaskStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_round"
                        android:fontFamily="@font/font_poppins"
                        android:letterSpacing="-0.016"
                        android:text="Today's Task Completed"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="normal" />
                    <!-- Circular counter -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center">

                        <ProgressBar
                            android:id="@+id/progressTask"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:indeterminate="false"
                            android:max="6"
                            android:progress="3"
                            android:progressDrawable="@drawable/bg_progress_yellow"
                            android:rotation="270" />

                        <TextView
                            android:id="@+id/tvTaskCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:fontFamily="@font/font_poppins_semibold"
                            android:gravity="center"
                            android:text="3/6"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_poppins_semibold"
                    android:text="Development Progress"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View style="@style/StyleSectionUnderline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Language -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rectangle"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <ProgressBar
                                android:id="@+id/progressLanguage"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="70"
                                android:progressDrawable="@drawable/bg_progress_yellow"
                                android:rotation="270" />

                            <TextView
                                android:id="@+id/textLanguageStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:fontFamily="@font/font_poppins"
                                android:text="Good"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="normal" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/textLanguageTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/font_poppins"
                            android:text="Language"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/textLanguageDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/font_poppins"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="Your children’s speaking or linguistic skills"
                            android:textColor="#626C71"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Motor -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rectangle"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <ProgressBar
                                android:id="@+id/progressMotor"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="95"
                                android:progressDrawable="@drawable/bg_progress_blue"
                                android:rotation="270" />

                            <TextView
                                android:id="@+id/textMotorStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:fontFamily="@font/font_poppins"
                                android:text="Excellent"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="normal" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/textMotorTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/font_poppins"
                            android:text="Motor"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/textMotorDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/font_poppins"
                            android:gravity="center"
                            android:letterSpacing="0"
                            android:paddingHorizontal="8dp"
                            android:text="Your children’s physical abilities that allow them to use muscles"
                            android:textColor="#626C71"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Cognitive -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rectangle"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <ProgressBar
                                android:id="@+id/progressCognitive"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="45"
                                android:progressDrawable="@drawable/bg_progress_red"
                                android:rotation="270" />

                            <TextView
                                android:id="@+id/textCognitiveStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:fontFamily="@font/font_poppins"
                                android:text="Developing"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="normal" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/textCognitiveTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/font_poppins"
                            android:text="Cognitive"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/textCognitiveDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/font_poppins"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="Your children’s mental abilities that enable them to think"
                            android:textColor="#626C71"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Social -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rectangle"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <ProgressBar
                                android:id="@+id/progressSocial"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="100"
                                android:progressDrawable="@drawable/bg_progress_green"
                                android:rotation="270" />

                            <TextView
                                android:id="@+id/textSocialStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:fontFamily="@font/font_poppins"
